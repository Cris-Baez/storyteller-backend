# ===================================

# OpenAI (para LLM)
OPENAI_API_KEY=sk-...tu-nueva-clave-openai

# Replicate (para video/imagen)
REPLICATE_API_TOKEN=r8_...tu-token-replicate

# RunwayML (para video)
RUNWAY_API_KEY=...tu-clave-runway

# ElevenLabs (para voz)
ELEVENLABS_API_KEY=...tu-clave-elevenlabs

# Murf (para voz alternativa)
MURF_API_KEY=...tu-clave-murf

# Google Cloud (para CDN)
GOOGLE_APPLICATION_CREDENTIALS=./keys/gcp-service-account.json
GCP_PROJECT_ID=tu-proyecto-gcp
GCP_BUCKET_NAME=storyteller-ai-cdn

# ===================================
# 🌐 CONFIGURACIÓN SERVIDOR
# ===================================
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*


generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 👤 MODELO DE USUARIO COMPLETO
model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  password    String
  name        String
  role        Role     @default(USER)
  plan        Plan     @default(STARTER)
  
  // Estado de verificación
  emailVerified           Boolean   @default(false)
  emailVerificationToken  String?   @unique
  
  // Reset de contraseña
  resetPasswordToken      String?   @unique
  resetPasswordExpires    DateTime?
  
  // Timestamps
  lastLogin  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  
  // Relaciones
  subscription    Subscription?
  usage          Usage?
  profile        Profile?
  preferences    Preferences?
  videos         Video[]
  marketingConfig MarketingConfig?
  projects       Project[]
  assets         Asset[]
  refreshTokens  RefreshToken[]
  
  @@map("users")
}

// 💳 SUSCRIPCIÓN
model Subscription {
  id               Int              @id @default(autoincrement())
  userId           Int              @unique
  status           SubscriptionStatus @default(INACTIVE)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  paypalSubscriptionId String?       @unique
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("subscriptions")
}

// 📊 USO SEMANAL
model Usage {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  videosThisWeek  Int      @default(0)
  weekResetDate   DateTime @default(now())
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("usage")
}

// 👤 PERFIL DE USUARIO
model Profile {
  id      Int     @id @default(autoincrement())
  userId  Int     @unique
  avatar  String?
  company String?
  phone   String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("profiles")
}

// ⚙️ PREFERENCIAS
model Preferences {
  id                   Int     @id @default(autoincrement())
  userId               Int     @unique
  emailNotifications   Boolean @default(true)
  marketingEmails      Boolean @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("preferences")
}

// 🎬 VIDEOS GENERADOS
model Video {
  id          Int       @id @default(autoincrement())
  userId      Int
  title       String
  description String?
  type        VideoType @default(CINEMA)
  status      VideoStatus @default(PENDING)
  
  // URLs y datos generados
  finalVideoUrl   String?
  thumbnailUrl    String?
  duration        Float?
  
  // Datos de entrada
  prompt          String?
  style           String?
  businessType    String?
  
  // Metadatos
  metadata        Json?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("videos")
}

// ⚙️ CONFIGURACIÓN DE MARKETING
model MarketingConfig {
  id           Int     @id @default(autoincrement())
  userId       Int     @unique
  businessType String?
  style        String?
  voiceType    String?
  musicStyle   String?
  frequency    String?
  tone         String?
  colors       String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("marketing_configs")
}

// 📁 PROYECTOS (PARA EDITOR VISUAL)
model Project {
  id          Int           @id @default(autoincrement())
  userId      Int
  title       String
  description String?
  status      ProjectStatus @default(DRAFT)
  data        Json?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("projects")
}

// 📎 ASSETS SUBIDOS POR USUARIO
model Asset {
  id       Int       @id @default(autoincrement())
  userId   Int
  filename String
  url      String
  type     AssetType
  size     Int
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("assets")
}

// 🔄 TOKENS DE REFRESCO
model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("refresh_tokens")
}

// 🔄 ENUMS
enum Role {
  USER
  ADMIN
  STUDIO_PRO
}

enum Plan {
  STARTER
  CREATOR
  STUDIO_PRO
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  EXPIRED
}

enum VideoType {
  CINEMA
  MARKETING
}

enum VideoStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssetType {
  IMAGE
  VIDEO
  AUDIO
  OTHER
}
